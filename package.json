{
  "name": "vee",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "eve dev",
    "build": "eve build",
    "start": "eve start",
    "test": "node --import ./scripts/test-loader.js --test agent/lib/*.test.js",
    "typecheck": "tsc",
    "routing:check": "node --import ./scripts/test-loader.js scripts/check-routing.js",
    "connections:check": "node --env-file-if-exists=.env.local --import ./scripts/test-loader.js scripts/connections.js check",
    "connections:authorize": "node --env-file-if-exists=.env.local --import ./scripts/test-loader.js scripts/connections.js authorize"
  },
  "dependencies": {
    "@ai-sdk/mcp": "2.0.36",
    "@vercel/connect": "0.2.7",
    "ai": "7.0.26",
    "eve": "^0.24.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "7.0.1-rc"
  },
  "packageManager": "pnpm@10.28.2"
}
