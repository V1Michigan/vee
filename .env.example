# Vee's existing Slack bot and the user OAuth connector are separate identities.
SLACK_CONNECTOR=slack/v1-ops
SLACK_SEARCH_CONNECTOR=slack/vee
VEE_SLACK_TEAM_ID=T02UZ8D4ZMY

# Fail closed by default. Fill in two actual Slack user IDs before the pilot.
VEE_SLACK_ROLLOUT=pilot
VEE_SLACK_PILOT_USERS=

# New turns: auto = explicit modes + narrow workflow rules, explicit = modes
# only, off = Luna only. Active turns keep their original model on resume.
VEE_MODEL_ROUTING=auto

# Durable Redis REST store supporting SET NX. No eviction or key TTLs.
# Obtain these through the project's secret environment configuration.
VEE_ACTION_REDIS_REST_URL=
VEE_ACTION_REDIS_REST_TOKEN=

# Optional: copy the authenticated Agent Runs page URL from Vercel after
# verifying availability and project-member permissions. No public trace links.
VEE_AGENT_RUNS_URL=

# Local development credentials are provisioned by Vercel, never committed.
# VERCEL_OIDC_TOKEN=
# AI_GATEWAY_API_KEY=
